+/**
+ * Replaces source-offset aliases emitted by ts-json-schema-generator-v2.
+ *
+ * The numeric suffixes describe transient declaration offsets and can change
+ * between otherwise identical fresh builds. AJV treats them only as internal
+ * definition keys, so a first-seen stable sequence preserves every reference
+ * while removing build-order entropy.
+ */
+function normalizeGeneratedAliasNames(code) {
+	const aliases = new Map();
+	return code.replace(/alias-(?:[0-9]+-)+[0-9]+/g, (alias) => {
+		if (!aliases.has(alias)) {
+			aliases.set(
+				alias,
+				`alias-wenpai-${String(aliases.size + 1).padStart(4, '0')}`
+			);
+		}
+		return aliases.get(alias);
+	});
 }
 
